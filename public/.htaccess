## Frontend SPA routing and 404 handling (Hostinger safe)

# Some hosts forbid Options directives; avoid to prevent 403
# (Directory listing is typically disabled by default on Hostinger)

# Ensure default index
DirectoryIndex index.html index.php

# Use index.html for 404s instead of hosting provider default page
ErrorDocument 404 /index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Fallback everything else to index.html (SPA routing)
  RewriteRule . /index.html [L]
</IfModule>

# Cache control (less aggressive; disable cache for HTML/PWA files)
<IfModule mod_expires.c>
  ExpiresActive On
  # Never cache HTML entry (always fetch latest SPA shell)
  ExpiresByType text/html "access plus 0 seconds"
  # Keep JS/CSS reasonable for dev; browsers will still revalidate
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  # Static images can be cached longer
  ExpiresByType image/avif "access plus 14 days"
  ExpiresByType image/webp "access plus 14 days"
  ExpiresByType image/svg+xml "access plus 14 days"
  ExpiresByType image/png "access plus 14 days"
  ExpiresByType image/jpeg "access plus 14 days"
  ExpiresByType image/gif "access plus 14 days"
  ExpiresByType image/x-icon "access plus 14 days"
  # PWA files should not be cached aggressively
  ExpiresByType application/manifest+json "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Ensure no-cache for HTML and PWA control files
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
  <FilesMatch "^(manifest\.json|sw\.js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>
</IfModule>
